PORT=3000

# Chave que assina os tokens de login (mínimo 32 caracteres).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=TROQUE_ESTA_CHAVE_POR_UMA_COM_PELO_MENOS_32_CARACTERES

# Endereço do(s) front-end(s) que podem chamar a API (separe vários por vírgula).
# Em produção, use o endereço do site publicado, com https:// e sem barra no final.
CORS_ORIGIN=http://localhost:5173

# Opção 1 (recomendada): endereço único de conexão, como o do Supabase.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/postgres
DB_SSL=true

# Opção 2: banco local em campos separados (apague a DATABASE_URL acima para usar).
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3307
# DB_NAME=aluguel_ferramentas
# DB_USER=root
# DB_PASS=